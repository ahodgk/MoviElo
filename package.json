{
	"name": "skincare-genie",
	"version": "0.0.0",
	"private": true,
	"sideEffects": true,
	"workspaces": [
		"apps/web",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"clean": "turbo run clean",
		"dev": "turbo run dev ",
		"start": "turbo run start",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"lint": "biome check --fix",
		"ci-lint": "biome lint",
		"fix": "biome lint --fix ",
		"test": "turbo run test",
		"db:migrate:dev": "(cd packages/database; yarn generate; yarn migrate)"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.2",
		"rimraf": "^6.0.1",
		"turbo": "latest"
	},
	"engines": {
		"node": ">=14.0.0",
		"npm": ">=7.0.0"
	},
	"packageManager": "yarn@4.8.1",
	"dependencies": {
		"@tanstack/react-pacer": "^0.17.0"
	}
}
